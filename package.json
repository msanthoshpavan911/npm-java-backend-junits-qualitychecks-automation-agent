{
  "name": "springbootquality-check911",
  "version": "1.0.22",
  "description": "GitHub Copilot agent for Spring Boot — auto-generates tests, fixes code smells, and validates JaCoCo coverage on every commit and push",
  "bin": {
    "springbootquality-check911": "./bin/springboot-quality-agent.js"
  },
  "scripts": {
    "test": "echo \"No tests\" && exit 0",
    "postinstall": "node scripts/setup-mcp.js"
  },
  "keywords": [
    "spring-boot",
    "copilot",
    "mcp",
    "junit",
    "quality",
    "jacoco",
    "checkstyle",
    "pmd",
    "spotbugs",
    "git-hooks"
  ],
  "author": "mamidi-santhosh",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "commands/",
    "scripts/",
    "config/",
    "mcp-server/server.py",
    "mcp-server/tools/*.py",
    "mcp-server/requirements.txt"
  ],
  "type": "commonjs",
  "dependencies": {
    "commander": "^15.0.0"
  }
}
